<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Controllo di compilazione: compila TUTTI gli script del gioco (anche l'interfaccia)
    contro le librerie di Unity, senza aprire l'editor.
    Uso: dotnet build unity/dotnet-check -p:UnityEditorPath=/percorso/di/Unity/Editor
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityEditorPath Condition="'$(UnityEditorPath)' == ''">/opt/unity/6000.3.29f1/Editor</UnityEditorPath>
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../MemeArena/Assets/MemeArena/Scripts/**/*.cs" />
    <Reference Include="$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.*Module.dll" Private="false" />
    <Reference Include="$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEditor.*Module.dll" Private="false" />
  </ItemGroup>
</Project>
